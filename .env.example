# HubSpot Private App token with scopes:
#   crm.objects.companies.read
#   crm.objects.companies.write
#   crm.schemas.companies.read
# (Settings -> Integrations -> Private Apps -> create one, scoped to Companies only)
HUBSPOT_TOKEN=

# Portal/account ID, used only to build clickable links to records (e.g. 145553937)
HUBSPOT_PORTAL_ID=

PORT=3000
